# Create boxplots for dataframe 8
plot_df4 <- ggplot(df_Mg, aes(x = Group, y = Value)) +
geom_boxplot() +
labs(title = "Magnesium Content",
x = "Groups", y = "Concentration (µg/g)")+
theme_minimal() +
theme(legend.position = "none", plot.title = element_text(hjust = 0.5))
# Arrange plots side by side
plot_df1 + plot_df2 + plot_df3 + plot_df4 + plot_layout(ncol = 4)
# Arrange plots side by side
plot_df1 + plot_df2 + plot_df3 + plot_df4 + plot_df5 + plot_df6 + plot_df7 + plot_df8 + plot_layout(ncol = 4)
